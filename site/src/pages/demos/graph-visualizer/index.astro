---
import Layout from '../../../layouts/Layout.astro';
import GraphVisualizer from '../../../components/graph-visualizer/GraphVisualizer.tsx';
---

<Layout
  title="Graph Visualizer — Jeff Arnold Labs"
  description="Paste a JSON node-edge dataset and explore it as an interactive force-directed graph."
  wide={true}
>
  <h1 class="text-2xl font-semibold">Graph Visualizer</h1>
  <p class="mt-2 max-w-3xl text-slate-700">
    Paste a JSON graph (nodes plus directional edges, each with a type and arbitrary properties)
    and render it as an interactive force-directed graph. Up to 1000 nodes and 2000 edges.
  </p>
  <GraphVisualizer client:only="react" />
</Layout>
